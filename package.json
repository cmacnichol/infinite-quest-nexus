{
  "name": "infinite-quest-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm check:repository && tsc -p tsconfig.json --noEmit && node --check apps/web/public/nexus.js && node --check apps/web/public/story.js",
    "check:data": "node scripts/check-repository-data.mjs",
    "check:repository": "node scripts/check-repository-boundaries.mjs && pnpm check:data",
    "dev": "tsx watch services/runtime/src/main.ts",
    "start": "node dist/services/runtime/src/main.js",
    "migrate": "tsx packages/database/src/migrate-cli.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:sogni-live": "vitest run tests/live/sogni-sdk-durability.live.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@sogni-ai/sogni-client": "5.2.0",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "fastify": "^5.4.0",
    "jszip": "^3.10.1",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.16.3",
    "photoswipe": "^5.4.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sentence-splitter": "^5.0.1",
    "sharp": "^0.35.3",
    "undici": "^8.9.0",
    "unzipper": "0.12.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/unzipper": "0.10.11",
    "linkedom": "0.18.13",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
