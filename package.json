{
  "name": "infinite-quest-nexus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --filter @infinite-quest/contracts check && pnpm --filter @infinite-quest/application check && pnpm --filter @infinite-quest/client-core check && pnpm --filter @infinite-quest/client-web check && tsc -p tsconfig.build.json && pnpm build:web:legacy && pnpm build:web:next",
    "build:web:legacy": "pnpm --filter @infinite-quest/web-legacy build",
    "build:web:next": "pnpm --filter @infinite-quest/web-next build",
    "check": "pnpm check:repository && pnpm --filter @infinite-quest/contracts check && pnpm --filter @infinite-quest/application check && pnpm --filter @infinite-quest/client-core check && pnpm --filter @infinite-quest/client-web check && pnpm check:web && tsc -p tsconfig.json --noEmit && node --check apps/web/public/nexus.js && node --check apps/web/src/story.js",
    "check:client-boundaries": "node scripts/check-client-boundaries.mjs",
    "check:data": "node scripts/check-repository-data.mjs",
    "check:repository": "node scripts/check-repository-boundaries.mjs && pnpm check:data",
    "check:web": "pnpm --filter @infinite-quest/web-legacy check && pnpm --filter @infinite-quest/web-next check",
    "check:web-bundle-budget": "node scripts/check-web-bundle-budget.mjs",
    "dev": "tsx watch services/runtime/src/main.ts",
    "dev:web": "pnpm --filter @infinite-quest/web-next dev",
    "start": "node dist/services/runtime/src/main.js",
    "migrate": "tsx packages/database/src/migrate-cli.ts",
    "evaluate:chronicle": "tsx scripts/evaluate-chronicle-retrieval.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:integration": "node scripts/run-isolated-integration.mjs",
    "test:e8:integration": "node scripts/run-e8-isolated-integration.mjs",
    "test:e3f:integration": "node scripts/run-e3f-isolated-integration.mjs",
    "test:sogni-live": "vitest run tests/live/sogni-sdk-durability.live.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.3",
    "@infinite-quest/contracts": "workspace:*",
    "@sogni-ai/sogni-client": "5.3.1",
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0",
    "fastify": "^5.11.0",
    "jszip": "^3.10.1",
    "node-pg-migrate": "9.0.0",
    "pg": "^8.23.0",
    "photoswipe": "^5.4.4",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sentence-splitter": "^5.0.1",
    "sharp": "^0.35.3",
    "undici": "^7.29.0",
    "unzipper": "0.12.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@babel/parser": "7.29.7",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/unzipper": "0.10.11",
    "linkedom": "0.18.13",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
