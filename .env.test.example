# Copying is unnecessary: scripts/ensure-test-database.mjs creates .env.test.local
# with a generated test-only password. Never commit .env.test.local.
POSTGRES_USER=infinitequest_test
POSTGRES_DB=infinitequest_test
POSTGRES_PASSWORD=replace-with-a-generated-local-test-password
TEST_POSTGRES_PORT=55432
TEST_DATABASE_URL=postgresql://infinitequest_test:replace-with-a-generated-local-test-password@127.0.0.1:55432/infinitequest_test
