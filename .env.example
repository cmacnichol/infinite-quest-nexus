# Copy to .env and set a unique URL-safe password for local Docker Compose.
POSTGRES_PASSWORD=

# Optional Compose overrides: docs/installation/environment-configuration.md
# Installation Settings setup: docs/runbooks/instance-settings.md

# Local single-user install: keep these with COMPOSE_FILE so even `docker compose -f compose.yaml` boots it.
# COMPOSE_PATH_SEPARATOR=|
# COMPOSE_FILE=compose.yaml|compose.local-single-user.yaml
# INSTANCE_SETTINGS_ACCESS_MODE=local-single-user
# APP_BIND_ADDRESS=127.0.0.1
