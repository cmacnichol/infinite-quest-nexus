APP_PORT=8080
LOG_LEVEL=info
POSTGRES_PASSWORD=replace-with-a-long-local-password
DATABASE_URL=postgresql://infinitequest:replace-me@postgres:5432/infinitequest
# Combined APP_ROLE=all default. Worker-only deployments may use 8; startup
# enforces concurrency + 8 for all and concurrency + 4 for worker.
DATABASE_MAX_CONNECTIONS=12
ASSET_STORAGE_DRIVER=filesystem
ASSET_STORAGE_ROOT=/var/lib/infinitequest/assets
ARCHIVE_STORAGE_ROOT=/var/lib/infinitequest/archives
LEGACY_WEB_ROOT=/app/apps/web/dist
NEXT_WEB_ROOT=/app/apps/web-next/dist
WORKER_POLL_INTERVAL_MS=2000
# Story-generation slots per worker replica. Approved range: 1 through 4.
WORKER_GENERATION_CONCURRENCY=1
MIGRATION_WAIT_SECONDS=120
# Leave false for normal startup. Enable only for a reviewed maintenance migration on an existing database.
ALLOW_MAINTENANCE_MIGRATIONS=false
# Local Docker Compose generates and persists this key on first start when left empty.
# Set a backed-up value here only when you need to supply the key explicitly.
CREDENTIAL_ENCRYPTION_KEY=
# Leave CORS_ALLOWED_ORIGINS unset for local same-origin browser access. Add exact origins for a separate browser host.
CORS_ALLOWED_ORIGINS=
# Public bearer-token world redemption remains disabled unless explicitly enabled.
WORLD_SHARING_ENABLED=false
# Add private inference hosts or CIDRs here when they are intentionally reachable from the API and worker.
PROVIDER_NETWORK_ALLOWLIST=
# Add exact remote image origins only when the web client needs to render them directly.
CSP_IMAGE_ALLOWED_ORIGINS=
# Request limits in bytes. Keep import and asset limits narrowly scoped.
API_DEFAULT_BODY_LIMIT_BYTES=1048576
API_IMPORT_BODY_LIMIT_BYTES=2147483648
API_ASSET_BODY_LIMIT_BYTES=33554432
